diff --git a/tests/test_apical_gate.py b/tests/test_apical_gate.py
new file mode 100644
index 00000000..e5b0b78b
--- /dev/null
+++ b/tests/test_apical_gate.py
@@ -0,0 +1,82 @@
+"""The gated apical compartment (``apical_gate``, opt-in): top-down input multiplies basal input."""
+
+from __future__ import annotations
+
+import hashlib
+
+import numpy as np
+import pytest
+
+from cadence import Brain
+from cadence.brain import Apical
+
+
+def _deep(**extra: object) -> Brain:
+    return Brain.compose(6, 4, modules=(12, 10, 8), apical=0.25, teaching="deep", seed=3,
+                         backend="cpu", recall=False, **extra)
+
+
+def _lived(brain: Brain) -> str:
+    """A short life's every output and parameter, hashed."""
+    rng = np.random.default_rng(0)
+    x = rng.random((5, 6))
+    out = []
+    for _ in range(4):
+        brain.lesson(x, rng.integers(0, 4, size=5))
+        out.append(np.asarray(brain.act(x, greedy=True)))
+        out.append(np.asarray(brain.basal_ganglia.state.activation))
+    out.append(np.asarray(brain.learner.brain.efficacy))
+    return hashlib.sha256(np.concatenate([np.ravel(o).astype(float) for o in out])
+                          .tobytes()).hexdigest()
+
+
+def test_gate_zero_is_the_additive_compartment_to_the_bit() -> None:
+    assert _lived(_deep()) == _lived(_deep(apical_gate=0.0))
+    assert "apical_gate" not in _deep().describe()["genes"]
+
+
+def test_the_gated_drive_multiplies_the_basal_input_within_its_bound() -> None:
+    rng = np.random.default_rng(1)
+    synapses = np.zeros(4, dtype=bool)
+    groups = np.array([0, 0, 0, -1])
+    plain = Apical(synapses, groups, 0.25)
+    gated = Apical(synapses, groups, 0.25, gate=0.5)
+    basal, raw = rng.normal(size=(3, 4)), rng.normal(size=(3, 4))
+    raw[:, 3] = 0.0
+    additive = plain.drive(basal, raw)
+    assert np.allclose(additive[:, :3], plain.gain(basal, raw)[:, :1] * raw[:, :3])
+    drive = gated.drive(basal, raw)
+    bound = 0.25 * np.sqrt(np.mean(basal[:, :3] ** 2, axis=1, keepdims=True))
+    assert np.allclose(drive[:, :3], 0.5 * np.tanh(additive[:, :3] / bound) * basal[:, :3])
+    factor = (basal[:, :3] + drive[:, :3]) / basal[:, :3]  # the basal input times 1 + g tanh
+    assert (factor > 0.5).all() and (factor < 1.5).all()
+    held = rng.random((3, 1))  # a nudged settle's held gain reaches the gate too
+    assert np.allclose(gated.drive(basal, raw, held)[:, :3],
+                       0.5 * np.tanh(held * raw[:, :3] / bound) * basal[:, :3])
+    with pytest.raises(ValueError, match="gate"):
+        Apical(synapses, groups, 0.25, gate=1.5)
+
+
+def test_a_gated_brain_learns_saves_and_loads(tmp_path) -> None:  # type: ignore[no-untyped-def]
+    brain = _deep(apical_gate=0.5)
+    assert brain.brain.backend == "cpu" and brain.brain.apical.gate == 0.5
+    assert brain.describe()["genes"]["apical_gate"] == 0.5
+    assert _lived(_deep(apical_gate=0.5)) != _lived(_deep())  # the gate acts
+    _lived(brain)
+    path = brain.save(tmp_path / "gated.npz")
+    again = Brain.load(path)
+    assert again.brain.apical.gate == 0.5
+    x = np.random.default_rng(2).random((5, 6))
+    brain.reset()
+    again.reset()
+    assert np.array_equal(brain.act(x, greedy=True), again.act(x, greedy=True))
+    assert np.allclose(brain.basal_ganglia.state.activation, again.basal_ganglia.state.activation)
+
+
+def test_the_gate_is_refused_without_a_compartment_or_off_the_cpu() -> None:
+    with pytest.raises(ValueError, match="apical_gate"):
+        Brain.compose(6, 4, modules=(12, 10), seed=0, backend="cpu", recall=False,
+                      apical_gate=0.5)
+    with pytest.raises(ValueError, match="CPU"):
+        Brain.compose(6, 4, modules=(12, 10), apical=0.25, seed=0, backend="torch",
+                      recall=False, apical_gate=0.5)
